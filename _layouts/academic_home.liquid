<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="chrome=1">
    <meta name="viewport" content="width=device-width">
    <meta name="description" content="{{ site.description | strip_html | strip_newlines | escape }}">
    <title>{{ site.title }}</title>
    {% if site.icon.size <= 4 %}
      <link
        rel="shortcut icon"
        href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>{{ site.icon }}</text></svg>"
      >
    {% elsif site.icon != blank %}
      <link rel="shortcut icon" href="{{ site.icon | prepend: '/assets/img/' | relative_url }}">
    {% endif %}
    <link rel="canonical" href="{{ page.url | replace: 'index.html', '' | absolute_url }}">
    <link rel="stylesheet" href="{{ '/assets/css/academicons.min.css' | relative_url }}">
    {% if site.enable_cookie_consent %}
      <link
        rel="stylesheet"
        href="{{ site.third_party_libraries.vanilla-cookieconsent.url.css }}"
        integrity="{{ site.third_party_libraries.vanilla-cookieconsent.integrity.css }}"
        crossorigin="anonymous"
      >
    {% endif %}
    <style>
      @font-face {
        font-family: "Font Awesome 7 Free";
        font-style: normal;
        font-weight: 900;
        font-display: block;
        src: url("{{ '/assets/webfonts/fa-solid-900.woff2' | relative_url }}") format("woff2");
      }

      @font-face {
        font-family: "Font Awesome 7 Brands";
        font-style: normal;
        font-weight: 400;
        font-display: block;
        src: url("{{ '/assets/webfonts/fa-brands-400.woff2' | relative_url }}") format("woff2");
      }

      :root {
        --accent: #075aa8;
        --accent-deep: #073f78;
        --ink: #20272e;
        --muted: #5e6872;
        --line: #dfe6ec;
        --surface: #fff;
        --surface-soft: #f5f8fb;
        --shadow: 0 18px 50px rgba(35, 56, 76, 0.09);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        min-height: 100vh;
        padding: 42px;
        color: #343b42;
        background: linear-gradient(135deg, #f3f7fa 0%, #fbfcfd 52%, #f2f6f9 100%);
        font-family: "lucida grande", "lucida sans unicode", lucida, "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 15px;
        line-height: 1.6;
        font-weight: 400;
      }

      a {
        color: var(--accent);
        text-decoration: none;
      }

      a:hover {
        color: var(--accent-deep);
        text-decoration: underline;
      }

      a:focus-visible {
        border-radius: 3px;
        outline: 3px solid rgba(7, 90, 168, 0.25);
        outline-offset: 3px;
      }

      p,
      ul,
      ol,
      table {
        margin: 0 0 0.7rem;
      }

      strong {
        color: var(--ink);
        font-weight: 700;
      }

      img {
        max-width: 100%;
      }

      .wrapper {
        width: 1120px;
        margin: 0 auto;
      }

      header {
        float: left;
        position: fixed;
        width: 260px;
        padding: 1.65rem 1.3rem 1.5rem;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--surface);
        box-shadow: var(--shadow);
        text-align: center;
      }

      section.content {
        float: right;
        width: 810px;
        padding: 1.55rem 2.1rem 2rem;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--surface);
        box-shadow: var(--shadow);
      }

      .avatar {
        width: 170px;
        height: 170px;
        margin: 0 auto 16px;
        overflow: hidden;
        border-radius: 100%;
      }

      .avatar img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      h1 {
        margin: 0 0 0.45rem;
        color: var(--ink);
        font-size: 250%;
        font-weight: 700;
        line-height: 1.05;
      }

      .name-local {
        display: block;
        white-space: nowrap;
      }

      h2,
      h3 {
        margin-top: 1em;
        margin-bottom: 0.45em;
        padding-top: 0.5em;
        padding-bottom: 0.2em;
        border-bottom: 1px solid var(--line);
        color: var(--ink);
        line-height: 1.15;
      }

      h2 {
        padding-top: 0.7em;
        font-size: 1.35rem;
        letter-spacing: -0.015em;
      }

      h3 {
        font-size: 110%;
        border-bottom: none;
      }

      h4 {
        margin: 1.2rem 0 0.35rem;
        color: var(--ink);
        font-size: 110%;
      }

      .subtitle,
      .affiliation {
        color: #555;
      }

      .subtitle {
        margin-bottom: 0.85rem;
        font-size: 0.95rem;
      }

      .affiliation p {
        margin: 0 0 0.3rem;
      }

      .icons {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.85rem;
        margin-bottom: 0.75rem;
      }

      .icons a {
        color: var(--ink);
        line-height: 1;
      }

      .icons a:hover {
        color: var(--accent);
        text-decoration: none;
      }

      .icon-solid,
      .icon-brand {
        display: inline-block;
        font-style: normal;
        font-size: 1.15rem;
        line-height: 1;
      }

      .icon-solid {
        font-family: "Font Awesome 7 Free";
        font-weight: 900;
      }

      .icon-brand {
        font-family: "Font Awesome 7 Brands";
        font-weight: 400;
      }

      .text-link {
        font-size: 0.88rem;
        font-weight: 600;
      }

      .secondary-links {
        display: flex;
        justify-content: center;
        gap: 0.35rem 0.75rem;
        margin: -0.15rem 0 0.85rem;
      }

      .secondary-links a {
        color: #666;
      }

      .secondary-links a:hover {
        color: var(--accent);
      }

      .contact {
        margin-top: 0.8rem;
      }

      .contact p {
        margin-bottom: 0;
        color: #555;
        font-family: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
        font-size: 0.8rem;
        line-height: 1.45;
      }

      .research-focus {
        margin: 0 0 1.25rem;
        padding: 1.05rem;
        border: 1px solid #dbe6f0;
        border-radius: 14px;
        background: linear-gradient(145deg, #f7fbff 0%, var(--surface-soft) 100%);
      }

      .research-focus .research-intro {
        margin: 0 0 0.8rem;
        color: var(--muted);
        font-size: 0.95rem;
        line-height: 1.5;
      }

      .research-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }

      .research-card {
        position: relative;
        min-width: 0;
        padding: 0.8rem 0.85rem 0.85rem;
        overflow: hidden;
        border: 1px solid #e0e8ef;
        border-top: 3px solid var(--accent);
        border-radius: 10px;
        background: var(--surface);
        box-shadow: 0 6px 18px rgba(35, 56, 76, 0.05);
      }

      .research-card:nth-child(2) {
        border-top-color: #2a7b78;
      }

      .research-card h3 {
        margin: 0.15rem 0 0.35rem;
        padding: 0;
        border: 0;
        color: var(--ink);
        font-size: 1.01rem;
        line-height: 1.35;
      }

      .research-card p {
        margin: 0;
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .research-number {
        color: var(--accent);
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.08em;
      }

      .research-card:nth-child(2) .research-number {
        color: #2a7b78;
      }

      .research-label {
        margin: 0 0 0.28rem;
        padding: 0;
        border: 0;
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 800;
        line-height: 1.2;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .quick-links {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.35rem 0.75rem;
        margin-top: 1rem;
        font-size: 0.95rem;
      }

      .news .table-responsive {
        max-height: none !important;
        overflow: visible;
      }

      .news table {
        width: 100%;
        border-collapse: collapse;
      }

      .news th,
      .news td {
        padding: 0.25rem 0;
        text-align: left;
        vertical-align: top;
      }

      .news th {
        width: 7.5rem !important;
        padding-right: 1rem;
        color: #444;
        font-weight: 700;
        white-space: nowrap;
      }

      .entries {
        display: grid;
        gap: 0.75rem;
      }

      .entry {
        padding: 0.72rem 0.82rem;
        border: 1px solid #e6ebf0;
        border-radius: 9px;
        background: #fbfcfd;
      }

      .entry-title {
        color: var(--ink);
        font-weight: 700;
      }

      .entry-title span,
      .entry-meta,
      .entry-note {
        color: var(--muted);
      }

      .entry-note {
        font-size: 0.95rem;
      }

      .presentation-list {
        display: grid;
        gap: 0.75rem;
      }

      .presentation-card {
        display: grid;
        grid-template-columns: 7.3rem minmax(0, 1fr);
        gap: 1rem;
        padding: 0.9rem 1rem;
        border: 1px solid #e1e7ed;
        border-radius: 10px;
        background: #fbfcfd;
      }

      .presentation-date {
        align-self: stretch;
        padding-right: 1rem;
        border-right: 1px solid var(--line);
        color: var(--accent);
        font-size: 0.79rem;
        font-weight: 800;
        font-variant-numeric: tabular-nums;
        line-height: 1.4;
      }

      .presentation-body {
        min-width: 0;
      }

      .presentation-meta {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.3rem 0.55rem;
        margin-bottom: 0.3rem;
        color: var(--muted);
        font-size: 0.79rem;
        font-weight: 600;
      }

      .presentation-kind {
        padding: 0.08rem 0.48rem;
        border-radius: 999px;
        color: var(--accent-deep);
        background: #e8f1fa;
        font-size: 0.69rem;
        font-weight: 800;
        letter-spacing: 0.035em;
        text-transform: uppercase;
      }

      .presentation-card h3 {
        margin: 0 0 0.35rem;
        padding: 0;
        border: 0;
        color: var(--ink);
        font-size: 1.01rem;
        line-height: 1.38;
      }

      .presentation-card p {
        margin: 0.2rem 0 0;
        color: var(--muted);
        font-size: 0.9rem;
        line-height: 1.5;
      }

      .presentation-related a,
      .presentation-link {
        font-weight: 700;
      }

      .publications {
        margin-top: 0;
      }

      .publications h1,
      .publications h2.bibliography {
        display: none;
      }

      .publications ol.bibliography {
        padding: 0;
        margin: 0;
        list-style: none;
      }

      .publications ol.bibliography > li {
        margin-bottom: 1.15rem;
        padding-bottom: 1.15rem;
        border-bottom: 1px solid #edf0f2;
      }

      .publications ol.bibliography > li:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: 0;
      }

      .publications .row {
        display: flex;
        align-items: flex-start;
        gap: 1.1rem;
        margin: 0;
      }

      .publications .abbr {
        flex: 0 0 225px;
        max-width: 225px;
        padding: 0;
      }

      .publications .abbr:not(:has(figure)) {
        flex: 0 0 auto;
        max-width: none;
      }

      .publications .abbr abbr {
        display: inline-block;
        min-width: 4.5rem;
        padding: 0.12rem 0.35rem;
        margin-bottom: 0.35rem;
        color: #fff;
        background: #777;
        border-radius: 3px;
        font-size: 0.72rem;
        font-weight: 700;
        text-align: center;
      }

      .publications figure {
        margin: 0;
      }

      .publications .preview {
        display: block;
        width: 225px;
        height: auto;
        object-fit: contain;
        object-position: center;
        border: 1px solid #e1e6eb;
        border-radius: 7px;
        background: var(--surface);
        box-shadow: 0 5px 16px rgba(35, 56, 76, 0.06);
      }

      .publications .row > div[id] {
        flex: 1 1 0;
        min-width: 0;
      }

      .publications .title {
        color: var(--ink);
        font-size: 1.02rem;
        font-weight: 700;
        line-height: 1.3;
      }

      .publications .author,
      .publications .periodical {
        color: var(--muted);
        font-size: 0.93rem;
        line-height: 1.4;
      }

      .publications .author em {
        color: var(--accent);
        font-style: normal;
        font-weight: 700;
      }

      .publications .links {
        margin-top: 0.25rem;
      }

      .publications .btn {
        display: inline;
        padding: 0;
        border: 0;
        color: var(--accent);
        background: transparent;
        box-shadow: none;
        font-size: 0.88rem;
      }

      .publications .btn::after {
        content: " /";
        color: #777;
      }

      .publications .btn:last-child::after {
        content: "";
      }

      .publications .hidden {
        display: none;
      }

      .publications .hidden.open {
        display: block;
        padding: 0.65rem 0.75rem;
        margin-top: 0.55rem;
        overflow-x: auto;
        border: 1px solid var(--line);
        border-radius: 7px;
        background: var(--surface-soft);
        font-size: 0.78rem;
      }

      .publications .hidden.open pre {
        margin: 0;
        white-space: pre-wrap;
      }

      .publications .links a[role="button"] {
        cursor: pointer;
      }

      .awards ul,
      .misc {
        padding-left: 1.2rem;
      }

      .awards li,
      .misc li {
        margin-bottom: 0.35rem;
      }

      footer {
        margin-top: 2.2rem;
        color: #aaa;
        font-size: 0.85rem;
      }

      @media print, screen and (max-width: 1220px) {
        body {
          padding: 28px 24px;
        }

        .wrapper {
          width: auto;
          max-width: 850px;
        }

        header,
        section.content {
          float: none;
          position: static;
          width: 100%;
        }

        header {
          margin-bottom: 1.25rem;
        }

        section.content {
          padding: 1.55rem 2rem 2rem;
        }

        .avatar {
          width: 145px;
          height: 145px;
        }

        .affiliation p {
          display: inline;
        }

        .affiliation p + p::before {
          content: " · ";
        }
      }

      @media print, screen and (max-width: 620px) {
        body {
          padding: 14px 12px;
        }

        header,
        section.content {
          border-radius: 12px;
        }

        header {
          padding: 1.25rem 1rem;
        }

        section.content {
          padding: 1.05rem 1rem 1.35rem;
        }

        h1 {
          font-size: 190%;
        }

        .avatar {
          width: 118px;
          height: 118px;
          margin-bottom: 12px;
        }

        .research-focus {
          padding: 0.85rem;
        }

        .research-grid {
          grid-template-columns: 1fr;
        }

        .presentation-card {
          grid-template-columns: 1fr;
          gap: 0.45rem;
          padding: 0.8rem 0.85rem;
        }

        .presentation-date {
          padding: 0 0 0.4rem;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .news th,
        .news td {
          display: block;
          width: 100% !important;
          padding: 0;
        }

        .news th {
          margin-top: 0.55rem;
        }

        .publications .row {
          display: block;
        }

        .publications .abbr {
          max-width: none;
          margin-bottom: 0.45rem;
        }

        .publications .preview {
          width: 100%;
          height: auto;
        }
      }
    </style>
  </head>

  <body>
    <div class="wrapper">
      <header>
        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <div class="avatar">
            <img src="{{ profile_image_path | relative_url }}" alt="{{ site.title }}">
          </div>
        {% endif %}

        <h1>
          Tong XIN
          <span class="name-local">(辛统)</span>
        </h1>
        {% if page.subtitle %}
          <p class="subtitle">{{ page.subtitle }}</p>
        {% endif %}

        <nav class="icons" aria-label="Profile links">
          {% if site.data.socials.github_username %}
            <a href="https://github.com/{{ site.data.socials.github_username }}" aria-label="GitHub" title="GitHub">
              <i class="icon-brand">&#xf09b;</i>
            </a>
          {% endif %}
          {% if site.data.socials.email %}
            <a href="mailto:{{ site.data.socials.email }}" aria-label="Email" title="Email"><i class="icon-solid">&#xf0e0;</i></a>
          {% endif %}
          {% if site.data.socials.scholar_userid %}
            <a
              href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
              aria-label="Google Scholar"
              title="Google Scholar"
            >
              <i class="ai ai-google-scholar"></i>
            </a>
          {% endif %}
        </nav>

        <nav class="secondary-links" aria-label="Other profiles">
          {% if site.data.socials.x and site.data.socials.x.url %}
            <a class="text-link" href="{{ site.data.socials.x.url }}" aria-label="X" title="X">X</a>
          {% endif %}
          {% if site.data.socials.xiaohongshu and site.data.socials.xiaohongshu.url %}
            <a class="text-link" href="{{ site.data.socials.xiaohongshu.url }}" aria-label="Xiaohongshu" title="Xiaohongshu">小红书</a>
          {% endif %}
          {% if site.data.socials.zhihu and site.data.socials.zhihu.url %}
            <a class="text-link" href="{{ site.data.socials.zhihu.url }}" aria-label="Zhihu" title="Zhihu">知乎</a>
          {% endif %}
        </nav>

        {% if page.profile.more_info %}
          <div class="affiliation">{{ page.profile.more_info }}</div>
        {% endif %}

        <div class="contact">
          {% if page.profile.contact %}
            <p>{{ page.profile.contact }}</p>
          {% elsif site.data.socials.email %}
            <p>{{ site.data.socials.email }}</p>
          {% endif %}
        </div>

        {% if page.sidebar_links %}
          <nav class="quick-links" aria-label="Main pages">
            {% for link in page.sidebar_links %}
              <a href="{{ link.url | relative_url }}">{{ link.title }}</a>
            {% endfor %}
          </nav>
        {% endif %}
      </header>

      <section class="content">
        <section id="about">{{ content }}</section>

        {% if page.selected_papers %}
          <section id="publications">
            <h2>Selected Publications</h2>
            {% include selected_papers.liquid %}
          </section>
        {% endif %}

        {% if page.presentations and page.presentations.size > 0 %}
          <section id="presentations" class="presentations">
            <h2>Presentations</h2>
            <div class="presentation-list">
              {% for presentation in page.presentations %}
                <article class="presentation-card">
                  <time class="presentation-date" datetime="{{ presentation.datetime }}">{{ presentation.date }}</time>
                  <div class="presentation-body">
                    <div class="presentation-meta">
                      <span class="presentation-kind">{{ presentation.kind }}</span>
                      <span>{{ presentation.venue }}</span>
                    </div>
                    <h3
                      {% if presentation.lang %}
                        lang="{{ presentation.lang }}"
                      {% endif %}
                    >
                      {{ presentation.title }}
                    </h3>
                    {% if presentation.description %}
                      <p>{{ presentation.description }}</p>
                    {% endif %}
                    {% if presentation.paper_title %}
                      <p class="presentation-related">
                        Based on our OSDI '26 paper:
                        {% if presentation.url %}
                          <a href="{{ presentation.url }}"
                            ><cite>{{ presentation.paper_title }}</cite></a
                          >.
                        {% else %}
                          <cite>{{ presentation.paper_title }}</cite>.
                        {% endif %}
                      </p>
                    {% elsif presentation.url %}
                      <a class="presentation-link" href="{{ presentation.url }}">{{ presentation.link_label | default: 'Learn more' }}</a>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% assign cv_projects = site.data.cv.cv.sections.Projects %}
        {% if cv_projects and cv_projects.size > 0 %}
          <section id="projects">
            <h2>Open Source</h2>
            <div class="entries">
              {% for project in cv_projects %}
                <div class="entry">
                  <div class="entry-title">
                    {% if project.url %}
                      <a href="{{ project.url }}">{{ project.name }}</a>
                    {% else %}
                      {{ project.name }}
                    {% endif %}
                  </div>
                  {% if project.summary %}
                    <div class="entry-meta">{{ project.summary }}</div>
                  {% endif %}
                  {% if project.highlights %}
                    {% for highlight in project.highlights limit: 1 %}
                      <div class="entry-note">{{ highlight }}</div>
                    {% endfor %}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% if page.announcements and page.announcements.enabled %}
          <section id="news">
            <h2>News</h2>
            {% include news.liquid limit=true %}
          </section>
        {% endif %}

        {% assign education = site.data.cv.cv.sections.Education %}
        {% if education and education.size > 0 %}
          <section id="education">
            <h2>Education</h2>
            <div class="entries">
              {% for item in education %}
                <div class="entry">
                  <div class="entry-title">
                    {% if item.url %}
                      <a href="{{ item.url }}">{{ item.institution }}</a>
                    {% else %}
                      {{ item.institution }}
                    {% endif %}
                    {% if item.location %}
                      <span>{{ item.location }}</span>
                    {% endif %}
                  </div>
                  <div class="entry-meta">
                    {{ item.studyType }}
                    {% if item.area %}
                      in {{ item.area }}
                    {% endif %}
                    {% if item.start_date or item.end_date %}
                      &bull; {{ item.start_date }} - {{ item.end_date }}
                    {% endif %}
                  </div>
                  {% if item.highlights %}
                    {% assign shown_highlights = 0 %}
                    {% for highlight in item.highlights %}
                      {% unless highlight contains 'GPA:' %}
                        {% if shown_highlights < 1 %}
                          <div class="entry-note">{{ highlight }}</div>
                          {% assign shown_highlights = shown_highlights | plus: 1 %}
                        {% endif %}
                      {% endunless %}
                    {% endfor %}
                  {% endif %}
                </div>
              {% endfor %}
            </div>
          </section>
        {% endif %}

        {% if page.awards and page.awards.enabled %}
          <section id="awards" class="awards">
            <h2>Awards</h2>
            {% include awards.liquid limit=page.awards.limit %}
          </section>
        {% endif %}

        {% if page.miscellaneous %}
          <section id="miscellaneous">
            <h2>Beyond Research</h2>
            <ul class="misc">
              {% for item in page.miscellaneous %}
                <li>{{ item | markdownify | remove: '<p>' | remove: '</p>' }}</li>
              {% endfor %}
            </ul>
          </section>
        {% endif %}

        <footer>
          &copy; {{ site.first_name }}
          {{ site.last_name }}
          {{ site.time | date: '%Y' }}
          {% if site.enable_visitor_counter %}
            <span id="site-visit-counter" hidden> · Total visits: <span id="busuanzi_site_pv"></span></span>
          {% endif %}
        </footer>
      </section>
    </div>

    <script>
      document.querySelectorAll('.publications a.bibtex').forEach(function (button) {
        const entry = button.closest('[id]');
        const panel = entry ? entry.querySelector('div.bibtex.hidden') : null;

        if (!entry || !panel) return;

        panel.id = entry.id + '-bibtex';
        button.setAttribute('href', '#' + panel.id);
        button.setAttribute('aria-controls', panel.id);
        button.setAttribute('aria-expanded', 'false');

        const togglePanel = function () {
          const willOpen = !panel.classList.contains('open');
          panel.classList.toggle('open', willOpen);
          button.setAttribute('aria-expanded', String(willOpen));
        };

        button.addEventListener('click', function (event) {
          event.preventDefault();
          togglePanel();
        });

        button.addEventListener('keydown', function (event) {
          if (event.key === ' ') {
            event.preventDefault();
            togglePanel();
          }
        });
      });
    </script>

    {% if site.enable_cookie_consent %}
      <script
        defer
        src="{{ site.third_party_libraries.vanilla-cookieconsent.url.js }}"
        integrity="{{ site.third_party_libraries.vanilla-cookieconsent.integrity.js }}"
        crossorigin="anonymous"
      ></script>
      <script defer src="{{ '/assets/js/cookie-consent-setup.js' | relative_url }}"></script>
    {% endif %}

    {% if site.enable_google_analytics %}
      <script
        {% if site.enable_cookie_consent %}
          type="text/plain" data-category="analytics"
        {% endif %}
        async
        src="https://www.googletagmanager.com/gtag/js?id={{ site.google_analytics }}"
      ></script>
      <script
        {% if site.enable_cookie_consent %}
          type="text/plain" data-category="analytics"
        {% endif %}
        defer
        src="{{ '/assets/js/google-analytics-setup.js' | relative_url }}"
      ></script>
    {% endif %}

    {% if site.enable_visitor_counter %}
      <script
        defer
        src="{{ '/assets/js/visitor-counter.js' | relative_url }}"
      ></script>
    {% endif %}
  </body>
</html>
